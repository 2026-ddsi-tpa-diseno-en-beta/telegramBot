<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <statusListener class="ch.qos.logback.core.status.OnErrorConsoleStatusListener"/>

    <!-- Appender de consola: siempre activo. Sirve para correr en local y porque
         Render captura stdout/stderr como logs del servicio de todas formas. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX,UTC} %-5level %logger{36}.%method:%line [trace=%X{traceId} instance=%X{instanceId} component=%X{component} req=%X{requestId}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
      Appender de Better Stack: SOLO se activa si existe la variable de entorno
      BETTERSTACK_SOURCE_TOKEN. Si no está seteada, el proyecto arranca igual y
      solo loguea por consola (así se puede desarrollar en local sin configurar
      Better Stack primero).

      El <if> tiene que envolver el <root> completo (como está acá), no al revés:
      ponerlo *adentro* de un <root> tira un warning de Logback
      (IfNestedWithinSecondPhaseElementSC) porque no está soportado.

      El atributo condition="..." de <if> está deprecado desde Logback 1.5.20
      (evalúa código Java en runtime vía Janino) y se va a remover en 2027. El
      reemplazo requiere una clase Java custom (PropertyEvaluator); para este TP
      es más complejidad de la que amerita, así que se deja así (solo tira warning,
      sigue andando).
    -->
    <if condition='isDefined("BETTERSTACK_SOURCE_TOKEN")'>
        <then>
            <appender name="BETTERSTACK" class="com.logtail.logback.LogtailAppender">
                <appName>${APP_NAME:-donatrack-telegram}</appName>
                <sourceToken>${BETTERSTACK_SOURCE_TOKEN}</sourceToken>
                <ingestUrl>${BETTERSTACK_INGEST_URL:-https://in.logs.betterstack.com}</ingestUrl>
                <mdcFields>traceId,requestId,instanceId,component,workerId,event,outcome,destination,status,durationMs,donacionId,paqueteId,necesidadId,quantity,reason</mdcFields>
                <mdcTypes>string,string,string,string,string,string,string,string,string,string,string,string,string,string,string</mdcTypes>
            </appender>

            <root level="INFO">
                <appender-ref ref="CONSOLE"/>
                <appender-ref ref="BETTERSTACK"/>
            </root>
        </then>
        <else>
            <root level="INFO">
                <appender-ref ref="CONSOLE"/>
            </root>
        </else>
    </if>

</configuration>
